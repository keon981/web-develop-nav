---
import Layout from "@/layouts/main.astro"
import { NavApp } from "@/components/nav/nav-app"
import { getNavData } from "@/lib/nav-data"

// SSG：在 build 時讀取 Notion 並產生靜態 HTML。
// Notion 有修改時，由 Notion webhook → GitHub Actions（等 10 分鐘）→ Cloudflare 重新 build。
const data = await getNavData()
---

<Layout>
  <NavApp client:load data={data} />
</Layout>
