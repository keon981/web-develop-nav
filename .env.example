# 本機開發：複製成 .env 後填入（.env 不會被 commit）：cp .env.example .env
# 部署：以下變數設定在 Cloudflare Pages 專案 → Settings → Variables and Secrets（Production）。

# ── Notion：build 時讀取資料（本機開發與 Cloudflare build 都需要）────────
# Integration Secret：https://www.notion.so/profile/integrations 建立 Internal integration 後取得
NOTION_TOKEN=
# 資料庫 ID，或直接貼資料庫網址；記得在資料庫右上角「⋯ → Connections」加入上面的 integration
NOTION_DATABASE_ID=

# ── Notion webhook 接收服務（只在 Cloudflare Pages 設定，本機不需要）────────
# Notion webhook 的 verification_token，用來驗證 X-Notion-Signature
NOTION_WEBHOOK_SECRET=
# GitHub fine-grained token：只授權這個 repo，權限「Actions: Read and write」，用來觸發 notion-rebuild workflow
GITHUB_DISPATCH_TOKEN=
# 觸發 workflow 的 repo，例如 keon981/web-develop-nav
GITHUB_DISPATCH_REPO=
# （選填）workflow 執行的分支，預設 main；workflow 檔必須在 repo 的預設分支上
GITHUB_DISPATCH_REF=

# ── Cloudflare Pages build 環境（只在 Cloudflare Pages 設定）────────────────
# Cloudflare build 映像檔預設 pnpm 10.11.1，指定成本專案使用的版本
# PNPM_VERSION=10.28.0

# ── GitHub repository secret（不是環境變數）──────────────────────────────
# 設定在 GitHub repo → Settings → Secrets and variables → Actions：
# CLOUDFLARE_DEPLOY_HOOK_URL = Cloudflare Pages 的 deploy hook 網址（Settings → Builds → Add deploy hook）
