# 複製成 .env 後填入（.env 不會被 commit）：cp .env.example .env
# 部署到 Vercel 等平台時，請在平台的 Environment Variables 設定相同的變數。

# ── Notion ───────────────────────────────────────────────
# Integration Secret：https://www.notion.so/profile/integrations 建立 Internal integration 後取得
NOTION_TOKEN=
# 資料庫 ID，或直接貼上資料庫的網址（https://www.notion.so/xxx/<資料庫ID>?v=...）
# 記得在資料庫右上角「⋯ → Connections」加入上面的 integration
NOTION_DATABASE_ID=

# ── 快取與更新 ───────────────────────────────────────────
# 頁面快取秒數：Notion 修改後最慢約這段時間會反映到網站（0 = 不快取，每次都讀 Notion）
CACHE_MAX_AGE=300
# （選填）Notion webhook 的 verification_token，設定後 Notion 一有變更就會立即更新網站
NOTION_WEBHOOK_SECRET=
# （選填）手動觸發更新的密鑰：curl -X POST -H "Authorization: Bearer <密鑰>" https://你的網域/api/revalidate
REVALIDATE_SECRET=
